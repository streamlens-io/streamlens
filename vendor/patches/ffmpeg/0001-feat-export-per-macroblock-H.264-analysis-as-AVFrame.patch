diff --git a/libavcodec/h264_mb.c b/libavcodec/h264_mb.c
index 0d6562b583..55f9d71a3e 100644
--- a/libavcodec/h264_mb.c
+++ b/libavcodec/h264_mb.c
@@ -815,4 +815,57 @@ void ff_h264_hl_decode_mb(const H264Context *h, H264SliceContext *sl)
         hl_decode_mb_simple_16(h, sl);
     } else
         hl_decode_mb_simple_8(h, sl);
+
+    /* Streamlens: fill per-MB analysis record */
+    if (h->sl_analysis_recs) {
+        /*
+         * sl_analysis_recs is indexed in raster order: sl->mb_y * h->mb_width + sl->mb_x.
+         * This is a compact layout (no stride padding) matching the blob header's
+         * mb_width/mb_height fields and what consumers iterate over.
+         * The other FFmpeg arrays (qscale_table, ref_index, motion_val) are still
+         * indexed by mb_xy (stride-based).
+         * b8_xy: index into ref_index[] (4 8x8 blocks per MB, 2x2 layout).
+         * b_xy:  base 4x4-block index into motion_val[] (b_stride = mb_width*4).
+         */
+        const int raster_idx = sl->mb_y * h->mb_width + sl->mb_x;
+        SLH264MBRecord *r    = (SLH264MBRecord *)h->sl_analysis_recs + raster_idx;
+        const int b8_xy      = 4 * mb_xy;
+        const int b_stride   = h->b_stride;
+        const int b_xy       = 4 * sl->mb_x + 4 * sl->mb_y * b_stride;
+
+        r->mb_type       = (uint32_t)mb_type;
+        r->qp            = h->cur_pic.qscale_table[mb_xy];
+        r->slice_id      = h->slice_table ? h->slice_table[mb_xy] : 0xFFFF;
+        r->transform_8x8 = IS_8x8DCT(mb_type) ? 1 : 0;
+
+        if (IS_INTRA4x4(mb_type)) {
+            for (int i = 0; i < 16; i++)
+                r->intra4x4_pred_modes[i] = sl->intra4x4_pred_mode_cache[scan8[i]];
+        } else {
+            memset(r->intra4x4_pred_modes, 0x7F, 16);
+        }
+        r->chroma_pred_mode     = IS_INTRA(mb_type)
+                                  ? (uint8_t)sl->chroma_pred_mode : 0xFF;
+        r->intra16x16_pred_mode = IS_INTRA16x16(mb_type)
+                                  ? (uint8_t)sl->intra16x16_pred_mode : 0xFF;
+
+        for (int i = 0; i < 4; i++)
+            r->sub_mb_type[i] = sl->sub_mb_type[i];
+
+        for (int list = 0; list < 2; list++) {
+            for (int part = 0; part < 4; part++)
+                r->ref_idx[list][part] = h->cur_pic.ref_index[list][b8_xy + part];
+            for (int row = 0; row < 4; row++) {
+                for (int col = 0; col < 4; col++) {
+                    const int blk          = row * 4 + col;
+                    const int16_t (*mv)[2] =
+                        &h->cur_pic.motion_val[list][b_xy + row * b_stride + col];
+                    r->mv[list][blk][0] = (*mv)[0];
+                    r->mv[list][blk][1] = (*mv)[1];
+                }
+            }
+        }
+
+        r->_pad[0] = r->_pad[1] = 0;
+    }
 }
diff --git a/libavcodec/h264_slice.c b/libavcodec/h264_slice.c
index 7e53e38cca..71d5700b23 100644
--- a/libavcodec/h264_slice.c
+++ b/libavcodec/h264_slice.c
@@ -530,6 +530,14 @@ static int h264_frame_start(H264Context *h)
     if ((ret = alloc_picture(h, pic)) < 0)
         return ret;
 
+    if (h->export_sl_analysis) {
+        ret = ff_h264_sl_analysis_alloc(h, pic);
+        if (ret < 0)
+            return ret;
+    } else {
+        h->sl_analysis_recs = NULL;
+    }
+
     h->cur_pic_ptr = pic;
     ff_h264_unref_picture(&h->cur_pic);
     if (CONFIG_ERROR_RESILIENCE) {
diff --git a/libavcodec/h264dec.c b/libavcodec/h264dec.c
index ab31832308..24125e8025 100644
--- a/libavcodec/h264dec.c
+++ b/libavcodec/h264dec.c
@@ -157,6 +157,8 @@ void ff_h264_free_tables(H264Context *h)
     av_freep(&h->mb2b_xy);
     av_freep(&h->mb2br_xy);
 
+    h->sl_analysis_recs = NULL;
+
     av_refstruct_pool_uninit(&h->qscale_table_pool);
     av_refstruct_pool_uninit(&h->mb_type_pool);
     av_refstruct_pool_uninit(&h->motion_val_pool);
@@ -858,6 +860,63 @@ static int h264_export_enc_params(AVFrame *f, const H264Picture *p)
     return 0;
 }
 
+/**
+ * Allocate the AV_FRAME_DATA_SL_H264_ANALYSIS blob on pic->f and set
+ * h->sl_analysis_recs to point at the per-MB records array.
+ * Called from h264_frame_start() in h264_slice.c when export_sl_analysis is set.
+ * The side data travels with the picture through the DPB, so display-order
+ * reordering is transparent.  Requires threads=1 (caller's responsibility).
+ */
+int ff_h264_sl_analysis_alloc(H264Context *h, H264Picture *pic)
+{
+    const unsigned int nb_mb = pic->mb_height * pic->mb_width;
+    const size_t blob_size   = sizeof(SLH264AnalysisHeader) +
+                               (size_t)nb_mb * sizeof(SLH264MBRecord);
+    AVFrameSideData *sd;
+    SLH264AnalysisHeader *hdr;
+    SLH264MBRecord *recs;
+
+    sd = av_frame_new_side_data(pic->f, AV_FRAME_DATA_SL_H264_ANALYSIS, blob_size);
+    if (!sd) {
+        h->sl_analysis_recs = NULL;
+        return AVERROR(ENOMEM);
+    }
+
+    hdr            = (SLH264AnalysisHeader *)sd->data;
+    hdr->version   = SL_H264_ANALYSIS_VERSION;
+    hdr->mb_width  = pic->mb_width;
+    hdr->mb_height = pic->mb_height;
+    hdr->mb_stride = pic->mb_stride;
+
+    recs = (SLH264MBRecord *)(sd->data + sizeof(SLH264AnalysisHeader));
+
+    /* Pre-fill sentinel values; ff_h264_hl_decode_mb fills real data per-MB. */
+    for (unsigned int i = 0; i < nb_mb; i++) {
+        memset(recs[i].intra4x4_pred_modes, 0x7F, 16);
+        recs[i].chroma_pred_mode      = 0xFF;
+        recs[i].intra16x16_pred_mode  = 0xFF;
+        recs[i].transform_8x8         = 0;
+        recs[i].qp                    = 0;
+        recs[i].slice_id              = 0xFFFF;
+        recs[i].mb_type               = 0;
+        recs[i]._pad[0] = recs[i]._pad[1] = 0;
+        memset(recs[i].sub_mb_type, 0, sizeof(recs[i].sub_mb_type));
+        memset(recs[i].mv,          0, sizeof(recs[i].mv));
+        memset(recs[i].ref_idx,    -1, sizeof(recs[i].ref_idx));
+    }
+
+    /*
+     * The recs array is indexed in RASTER order: mb_y * mb_width + mb_x.
+     * h->sl_analysis_recs is a void* to avoid requiring sl_h264_analysis.h
+     * in h264_slice.c; h264_mb.c casts it back to SLH264MBRecord*.
+     * Note: recs must not be accessed after any frame realloc; since we store
+     * the pointer before decoding any MB and h264 does not reallocate pic->f
+     * after alloc, this is safe.
+     */
+    h->sl_analysis_recs = recs;
+    return 0;
+}
+
 static int output_frame(H264Context *h, AVFrame *dst, H264Picture *srcp)
 {
     int ret;
@@ -888,6 +947,10 @@ static int output_frame(H264Context *h, AVFrame *dst, H264Picture *srcp)
             goto fail;
     }
 
+    /* AV_FRAME_DATA_SL_H264_ANALYSIS is already on srcp->f (placed at frame
+     * start by ff_h264_sl_analysis_alloc and filled per-MB); av_frame_ref
+     * above has copied it to dst automatically. */
+
     if (!(h->avctx->export_side_data & AV_CODEC_EXPORT_DATA_FILM_GRAIN))
         av_frame_remove_side_data(dst, AV_FRAME_DATA_FILM_GRAIN_PARAMS);
 
@@ -1097,6 +1160,7 @@ static const AVOption h264_options[] = {
     { "x264_build", "Assume this x264 version if no x264 version found in any SEI", OFFSET(x264_build), AV_OPT_TYPE_INT, {.i64 = -1}, -1, INT_MAX, VD },
     { "skip_gray", "Do not return gray gap frames", OFFSET(skip_gray), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
     { "noref_gray", "Avoid using gray gap frames as references", OFFSET(noref_gray), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, VD },
+    { "export_sl_analysis", "Export Streamlens per-MB analysis side data (requires threads=1)", OFFSET(export_sl_analysis), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
     { NULL },
 };
 
