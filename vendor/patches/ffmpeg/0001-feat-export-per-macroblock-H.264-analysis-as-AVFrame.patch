diff --git a/libavutil/sl_h264_analysis.h b/libavutil/sl_h264_analysis.h
new file mode 100644
index 0000000000..816990dc1c
--- /dev/null
+++ b/libavutil/sl_h264_analysis.h
@@ -0,0 +1,124 @@
+/*
+ * Streamlens H.264 per-macroblock analysis side data
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Streamlens per-macroblock H.264 analysis side data layout.
+ *
+ * Enabled by setting the AVOption "export_sl_analysis" to 1 on the h264
+ * decoder.  Requires threads=1 (frame threading is incompatible with
+ * per-MB intra-mode capture; the decoder will NOT force this — the caller
+ * must set it).
+ *
+ * The AVFrameSideData blob attached as AV_FRAME_DATA_SL_H264_ANALYSIS is:
+ *
+ *   SLH264AnalysisHeader   (fixed, at offset 0)
+ *   SLH264MBRecord[mb_width * mb_height]  (raster order, row-major)
+ *
+ * All fields are native-endian (the library and consumer are always the
+ * same binary).  The struct is packed to avoid padding surprises on
+ * platforms where int alignment > 1.
+ *
+ * Version history:
+ *   1 — initial layout
+ */
+
+#ifndef AVUTIL_SL_H264_ANALYSIS_H
+#define AVUTIL_SL_H264_ANALYSIS_H
+
+#include <stdint.h>
+
+#define SL_H264_ANALYSIS_VERSION 1
+
+/**
+ * Header placed at the start of the AV_FRAME_DATA_SL_H264_ANALYSIS blob.
+ */
+typedef struct SLH264AnalysisHeader {
+    uint32_t version;       /**< Always SL_H264_ANALYSIS_VERSION */
+    uint32_t mb_width;      /**< Width in macroblocks */
+    uint32_t mb_height;     /**< Height in macroblocks */
+    uint32_t mb_stride;     /**< Stride in macroblocks (may be > mb_width) */
+} __attribute__((packed)) SLH264AnalysisHeader;
+
+/**
+ * Per-macroblock analysis record.  One entry per MB in raster order
+ * (row * mb_width + col), NOT row * mb_stride + col.
+ *
+ * mb_type:
+ *   Raw uint32 from FFmpeg's internal mb_type array (mpegutils.h macros
+ *   IS_INTRA4x4, IS_INTRA16x16, IS_SKIP, IS_DIRECT, IS_INTRA, etc.).
+ *   Bit definitions match MB_TYPE_* in libavcodec/mpegutils.h.
+ *
+ * intra4x4_pred_modes:
+ *   Valid only when IS_INTRA4x4(mb_type).  16 entries in scan4 order
+ *   (FFmpeg's scan8[] indices 0..15, which map to the 4x4 luma blocks
+ *   in standard H.264 raster-within-MB order).
+ *   Values are FFmpeg internal intra4x4 mode codes:
+ *     0-8:  standard H.264 intra4x4 prediction modes
+ *     9:    LEFT_DC_PRED  (DC using left samples only; top unavailable)
+ *     10:   TOP_DC_PRED   (DC using top samples only; left unavailable)
+ *     11:   DC_128_PRED   (DC using constant 128; both neighbors unavailable)
+ *   Set to 0x7F when not applicable (non-intra4x4 MB).
+ *
+ * ref_idx[list][part]:
+ *   Reference index per 8x8 partition (0..3), per list (0=L0, 1=L1).
+ *   -1 = not used / not available for this list.
+ *
+ * mv[list][blk4x4][xy]:
+ *   Motion vector in quarter-pel units, per 4x4 block (0..15) per list.
+ *   blk4x4 is in scan4/scan8 order (matches FFmpeg's motion_val layout).
+ *   0 when not applicable.
+ *
+ * sub_mb_type[part]:
+ *   Sub-MB partition type for 8x8 partitions (0..3), in MB_TYPE_* units.
+ *   0 when not a P/B 8x8 partition MB.
+ *
+ * chroma_pred_mode:
+ *   H.264 intra chroma prediction mode (0=DC,1=Horiz,2=Vert,3=Plane).
+ *   0xFF when not an intra MB.
+ *
+ * intra16x16_pred_mode:
+ *   H.264 intra-16x16 luma prediction mode.
+ *   0xFF when not IS_INTRA16x16.
+ *
+ * transform_8x8:
+ *   1 if 8x8 DCT is used (IS_8x8DCT), 0 otherwise.
+ *
+ * qp:
+ *   Quantisation parameter for this MB (luma).
+ *
+ * slice_id:
+ *   Slice index for this MB (from h->slice_table), or 0xFFFF if unknown.
+ */
+typedef struct SLH264MBRecord {
+    uint32_t mb_type;
+    uint32_t sub_mb_type[4];
+    int16_t  mv[2][16][2];
+    int8_t   ref_idx[2][4];
+    int8_t   intra4x4_pred_modes[16];
+    uint8_t  chroma_pred_mode;
+    uint8_t  intra16x16_pred_mode;
+    uint8_t  transform_8x8;
+    int8_t   qp;
+    uint16_t slice_id;
+    uint8_t  _pad[2];
+} __attribute__((packed)) SLH264MBRecord;
+
+#endif /* AVUTIL_SL_H264_ANALYSIS_H */
-- 
