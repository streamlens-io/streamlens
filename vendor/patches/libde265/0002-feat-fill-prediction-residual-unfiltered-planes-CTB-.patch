+
+
+LIBDE265_API void de265_internals_get_CTB_bits(const struct de265_image* img,
+                                               uint32_t* out)
+{
+  int w = 0, h = 0, log2 = 0;
+  img->internals_get_CTB_Info_Layout(&w, &h, &log2);
+  int n = w * h;
+  if (img->ctb_bits) {
+    memcpy(out, img->ctb_bits, n * sizeof(uint32_t));
+  } else {
+    memset(out, 0, n * sizeof(uint32_t));
+  }
+}
+
+
+LIBDE265_API int de265_internals_get_image_poc(const struct de265_image* img)
+{
+  return img->PicOrderCntVal;
+}
