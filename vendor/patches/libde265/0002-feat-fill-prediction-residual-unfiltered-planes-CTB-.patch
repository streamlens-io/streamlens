diff --git a/libde265/decctx.cc b/libde265/decctx.cc
index 34ee2e61..0a1c1d4a 100644
--- a/libde265/decctx.cc
+++ b/libde265/decctx.cc
@@ -622,6 +622,24 @@ de265_error decoder_context::decode_some(bool* did_work)
 
 
 
+    // capture unfiltered frame before deblock/SAO
+    {
+      de265_image* fimg = imgunit->img;
+      if (fimg->pixels_unfiltered[0]) {
+        int bpp_y = (fimg->BitDepth_Y + 7) / 8;
+        int bpp_c = (fimg->BitDepth_C + 7) / 8;
+        ptrdiff_t ls = fimg->get_luma_stride();
+        ptrdiff_t cs = fimg->get_chroma_stride();
+        size_t luma_bytes   = static_cast<size_t>(ls) * fimg->get_height(0) * bpp_y;
+        size_t chroma_bytes = static_cast<size_t>(cs) * fimg->get_height(1) * bpp_c;
+        memcpy(fimg->pixels_unfiltered[0], fimg->get_image_plane(0), luma_bytes);
+        if (fimg->pixels_unfiltered[1] && fimg->get_image_plane(1))
+          memcpy(fimg->pixels_unfiltered[1], fimg->get_image_plane(1), chroma_bytes);
+        if (fimg->pixels_unfiltered[2] && fimg->get_image_plane(2))
+          memcpy(fimg->pixels_unfiltered[2], fimg->get_image_plane(2), chroma_bytes);
+      }
+    }
+
     // run post-processing filters (deblocking & SAO)
 
     if (img->decctx->num_worker_threads)
