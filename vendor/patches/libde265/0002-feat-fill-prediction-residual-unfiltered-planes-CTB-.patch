diff --git a/libde265/slice.cc b/libde265/slice.cc
index c46919ed..e05b36de 100644
--- a/libde265/slice.cc
+++ b/libde265/slice.cc
@@ -4803,8 +4803,20 @@ enum DecodeResult decode_substream(thread_context* tctx,
       return Decode_Error;
     }
 
+    // record CABAC byte position before decoding this CTU
+    const uint8_t* cabac_before = tctx->cabac_decoder.bitstream_curr;
+
     read_coding_tree_unit(tctx);
 
+    // store CTB bit count (byte delta × 8, ~8-bit CABAC granularity)
+    if (tctx->img->ctb_bits) {
+      const uint8_t* cabac_after = tctx->cabac_decoder.bitstream_curr;
+      ptrdiff_t byte_delta = cabac_after - cabac_before;
+      if (byte_delta < 0) byte_delta = 0; // paranoia: byte position should not go backwards
+      uint32_t bits = static_cast<uint32_t>(byte_delta) * 8;
+      tctx->img->ctb_bits[ctbx + ctby * ctbW] = bits;
+    }
+
 
     // save CABAC-model for WPP (except in last CTB row)
 
diff --git a/libde265/transform.cc b/libde265/transform.cc
index 4d832eb9..56d6a7eb 100644
--- a/libde265/transform.cc
+++ b/libde265/transform.cc
@@ -22,6 +22,7 @@
 #include "util.h"
 
 #include <assert.h>
+#include <string.h>
 
 
 const int tab8_22[] = { 29,30,31,32,33,33,34,34,35,35,36,36,37 /*,37*/ };
@@ -401,6 +402,24 @@ void scale_coefficients_internal(thread_context* tctx,
   //assert(intra == (tctx->img->get_pred_mode(xT,yT)==MODE_INTRA));
   int cuPredModeIntra = (tctx->img->get_pred_mode(xT,yT)==MODE_INTRA);
 
+  // --- internals: capture prediction (8-bit only) ---
+  // pred currently holds the intra/inter prediction samples; copy before add_residual.
+  const bool capture_pred = (sizeof(pixel_t)==1) &&
+                             (tctx->img->pixels_prediction[cIdx] != nullptr);
+  const bool capture_res  = (sizeof(pixel_t)==1) &&
+                             (tctx->img->pixels_residual[cIdx]   != nullptr);
+  if (capture_pred || capture_res) {
+    // Store the prediction block so we can compute residual after.
+    // We write directly to the internals plane (same stride as main plane).
+    if (capture_pred) {
+      uint8_t* dst = tctx->img->pixels_prediction[cIdx] +
+                     xT + static_cast<ptrdiff_t>(yT) * stride;
+      const uint8_t* src = reinterpret_cast<const uint8_t*>(pred);
+      for (int row = 0; row < nT; row++)
+        memcpy(dst + row * stride, src + row * stride, nT);
+    }
+  }
+
   bool rotateCoeffs = (sps.range_extension.transform_skip_rotation_enabled_flag &&
                        nT == 4 &&
                        cuPredModeIntra);
@@ -634,6 +653,30 @@ void scale_coefficients_internal(thread_context* tctx,
     logtrace(LogTransform,"*\n");
   }
 
+  // --- internals: capture residual (8-bit only) ---
+  // pred now holds reconstructed samples; prediction plane (captured above) holds prediction.
+  // Residual = reconstructed - prediction, stored with +128 bias as u8.
+  if (capture_res) {
+    const uint8_t* pred_plane = tctx->img->pixels_prediction[cIdx];
+    uint8_t*       res_plane  = tctx->img->pixels_residual[cIdx];
+    if (pred_plane && res_plane) {
+      const uint8_t* pred_src  = pred_plane + xT + static_cast<ptrdiff_t>(yT) * stride;
+      const uint8_t* recon_src = reinterpret_cast<const uint8_t*>(pred);
+      uint8_t*       res_dst   = res_plane  + xT + static_cast<ptrdiff_t>(yT) * stride;
+      for (int row = 0; row < nT; row++) {
+        for (int col = 0; col < nT; col++) {
+          int r = static_cast<int>(recon_src[row * stride + col]) -
+                  static_cast<int>(pred_src [row * stride + col]);
+          // clamp to [0,255] with +128 bias
+          int v = r + 128;
+          if (v < 0) v = 0;
+          else if (v > 255) v = 255;
+          res_dst[row * stride + col] = static_cast<uint8_t>(v);
+        }
+      }
+    }
+  }
+
   // zero out scrap coefficient buffer again
 
   for (int i=0;i<tctx->nCoeff[cIdx];i++) {
