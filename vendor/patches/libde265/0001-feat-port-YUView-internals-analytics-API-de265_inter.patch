+  void internals_get_CB_info(uint16_t *idxArray) const
+  {
+    for (int i = 0; i < cb_info.size(); i++) {
+      const CB_ref_info& cb = cb_info[i];
+      uint16_t v = 0;
+      v  = static_cast<uint16_t>(cb.log2CbSize & 0x7);        // bits 0:2
+      v |= static_cast<uint16_t>((cb.PartMode  & 0x7) << 3);  // bits 3:5
+      v |= static_cast<uint16_t>((cb.PredMode  & 0x3) << 6);  // bits 6:7
+      if (cb.pcm_flag)              v |= (1 << 8);             // bit 8
+      if (cb.cu_transquant_bypass)  v |= (1 << 9);             // bit 9
+      idxArray[i] = v;
+    }
+  }
+
+  void internals_get_CB_QP(int8_t *qpArray) const
