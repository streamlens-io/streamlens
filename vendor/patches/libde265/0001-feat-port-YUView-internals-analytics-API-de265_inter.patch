diff --git a/libde265/image.cc b/libde265/image.cc
index 82078e66..765d0dc4 100644
--- a/libde265/image.cc
+++ b/libde265/image.cc
@@ -194,6 +194,81 @@ void de265_image::set_image_plane(int cIdx, uint8_t* mem, ptrdiff_t stride, void
 }
 
 
+void de265_image::alloc_internals_planes(bool save_prediction, bool save_residual, bool save_tr_coeff)
+{
+  // luma: stride * height bytes (already set from main allocation)
+  size_t luma_bytes   = static_cast<size_t>(stride)        * height        * ((BitDepth_Y+7)/8) + MEMORY_PADDING;
+  size_t chroma_bytes = static_cast<size_t>(chroma_stride) * chroma_height * ((BitDepth_C+7)/8) + MEMORY_PADDING;
+
+  bool mono = (chroma_format == de265_chroma_mono);
+
+  struct PlaneSet {
+    uint8_t** raw;
+    uint8_t** confwin;
+    bool       enabled;
+  } sets[3] = {
+    { pixels_prediction, pixels_confwin_prediction, save_prediction },
+    { pixels_residual,   pixels_confwin_residual,   save_residual   },
+    { pixels_tr_coeff,   pixels_confwin_tr_coeff,   save_tr_coeff   },
+  };
+
+  // conformance window offsets (pixel units per channel)
+  int sps_left   = sps ? sps->conf_win_left_offset   : 0;
+  int sps_top    = sps ? sps->conf_win_top_offset     : 0;
+  uint8_t WinUnitX = SubWidthC, WinUnitY = SubHeightC;
+
+  for (auto& s : sets) {
+    if (!s.enabled) {
+      for (int c = 0; c < 3; c++) { s.raw[c] = nullptr; s.confwin[c] = nullptr; }
+      continue;
+    }
+    s.raw[0] = static_cast<uint8_t*>(ALLOC_ALIGNED_16(luma_bytes));
+    if (s.raw[0]) memset(s.raw[0], 0, luma_bytes);
+
+    if (!mono) {
+      s.raw[1] = static_cast<uint8_t*>(ALLOC_ALIGNED_16(chroma_bytes));
+      s.raw[2] = static_cast<uint8_t*>(ALLOC_ALIGNED_16(chroma_bytes));
+      if (s.raw[1]) memset(s.raw[1], 0, chroma_bytes);
+      if (s.raw[2]) memset(s.raw[2], 0, chroma_bytes);
+    } else {
+      s.raw[1] = nullptr;
+      s.raw[2] = nullptr;
+    }
+
+    // set confwin pointers
+    int bpp_y = (BitDepth_Y+7)/8;
+    int bpp_c = (BitDepth_C+7)/8;
+    if (s.raw[0])
+      s.confwin[0] = s.raw[0] + (sps_left*WinUnitX + sps_top*WinUnitY*(int)stride) * bpp_y;
+    else
+      s.confwin[0] = nullptr;
+
+    for (int c = 1; c < 3; c++) {
+      if (s.raw[c])
+        s.confwin[c] = s.raw[c] + (sps_left + sps_top*(int)chroma_stride) * bpp_c;
+      else
+        s.confwin[c] = nullptr;
+    }
+  }
+}
+
+
+void de265_image::release_internals_planes()
+{
+  for (int c = 0; c < 3; c++) {
+    FREE_ALIGNED(pixels_prediction[c]);
+    FREE_ALIGNED(pixels_residual[c]);
+    FREE_ALIGNED(pixels_tr_coeff[c]);
+    pixels_prediction[c]         = nullptr;
+    pixels_confwin_prediction[c] = nullptr;
+    pixels_residual[c]           = nullptr;
+    pixels_confwin_residual[c]   = nullptr;
+    pixels_tr_coeff[c]           = nullptr;
+    pixels_confwin_tr_coeff[c]   = nullptr;
+  }
+}
+
+
 de265_image::de265_image() = default;
 
 
@@ -442,6 +517,17 @@ de265_error de265_image::alloc_image(int w,int h, enum de265_chroma c,
       }
   }
 
