@@ -0,0 +1,165 @@
+/*
+ * H.265 video codec.
+ * Copyright (c) 2013-2014 struktur AG, Dirk Farin <farin@struktur.de>
+ *
+ * libde265 internals analytics API — streamlens port.
+ * Original: https://github.com/ChristianFeldmann/libde265/tree/internal
+ * Adapted for mainline v1.1.x by the streamlens project.
+ *
+ * This file is part of libde265.
+ *
+ * libde265 is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as
+ * published by the Free Software Foundation, either version 3 of
+ * the License, or (at your option) any later version.
+ *
+ * libde265 is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with libde265.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef DE265_INTERNALS_H
+#define DE265_INTERNALS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include "libde265/de265.h"
+
+/* Decoder params that enable saving of extra signal planes. */
+enum de265_internals_param {
+  DE265_INTERNALS_DECODER_PARAM_SAVE_PREDICTION = 0,
+  DE265_INTERNALS_DECODER_PARAM_SAVE_RESIDUAL,
+  DE265_INTERNALS_DECODER_PARAM_SAVE_TR_COEFF
+};
+
+/*
+ * Enable/disable saving of prediction / residual / transform-coefficient planes.
+ * Must be called BEFORE decoding starts (before any pictures are decoded).
+ */
+LIBDE265_API void de265_internals_set_parameter_bool(de265_decoder_context*,
+                                                     enum de265_internals_param param,
+                                                     int value);
+
+/*
+ * Retrieve a saved auxiliary image plane.
+ * signal: which plane (SAVE_PREDICTION / SAVE_RESIDUAL / SAVE_TR_COEFF)
+ * channel: 0=luma, 1=Cb, 2=Cr
+ * out_stride: set to bytes-per-row (stride * bytes-per-sample)
+ * Returns NULL if the plane was not saved.
+ */
+LIBDE265_API const uint8_t* de265_internals_get_image_plane(const struct de265_image* img,
+                                                            enum de265_internals_param signal,
+                                                            int channel,
+                                                            int* out_stride);
+
+/*
+ * CTB grid layout.
+ * Grid unit = 1 CTB.  Units per row = ceil(width / CTB_size).
+ */
+LIBDE265_API void de265_internals_get_CTB_Info_Layout(const struct de265_image* img,
+                                                      int* widthInUnits,
+                                                      int* heightInUnits,
+                                                      int* log2UnitSize);
+
+/*
+ * Per-CTB slice index (SliceAddrRS).
+ * idxArray must hold widthInUnits * heightInUnits elements (uint16_t).
+ */
+LIBDE265_API void de265_internals_get_CTB_sliceIdx(const struct de265_image* img,
+                                                   uint16_t* idxArray);
+
+/*
+ * CB grid layout.
+ * Grid unit = 1 min-CB (side = 1 << log2UnitSize).
+ */
+LIBDE265_API void de265_internals_get_CB_Info_Layout(const struct de265_image* img,
+                                                     int* widthInUnits,
+                                                     int* heightInUnits,
+                                                     int* log2UnitSize);
+
+/*
+ * Per min-CB packed info word (uint16_t):
+ *   bits 0:2  log2CbSize  (non-zero only at top-left of CB)
+ *   bits 3:5  PartMode
+ *   bits 6:7  PredMode  (0=INTRA, 1=INTER, 2=SKIP)
+ *   bit  8    pcm_flag
+ *   bit  9    cu_transquant_bypass
+ * idxArray: widthInUnits * heightInUnits elements.
+ */
+LIBDE265_API void de265_internals_get_CB_info(const struct de265_image* img,
+                                              uint16_t* idxArray);
+
+/*
+ * Per min-CB QP_Y (int8_t, range [0,51]).
+ * Same grid convention as get_CB_info.
+ * idxArray: widthInUnits * heightInUnits elements.
+ */
+LIBDE265_API void de265_internals_get_CB_QP(const struct de265_image* img,
+                                            int8_t* qpArray);
+
+/*
+ * PB grid layout.
+ * Grid unit = 1 min-PU (side = 1 << log2UnitSize, typically 4 pixels).
+ */
+LIBDE265_API void de265_internals_get_PB_Info_layout(const struct de265_image* img,
+                                                     int* widthInUnits,
+                                                     int* heightInUnits,
+                                                     int* log2UnitSize);
+
+/*
+ * Per min-PU motion info.
+ * refPOC0/1: reference POC for list 0 / list 1; -1 = list not used.
+ * x0/y0, x1/y1: motion vector for list 0 / list 1 (in 1/4-pel units).
+ * All arrays: widthInUnits * heightInUnits elements.
+ */
+LIBDE265_API void de265_internals_get_PB_info(const struct de265_image* img,
+                                              int16_t* refPOC0, int16_t* refPOC1,
+                                              int16_t* x0, int16_t* y0,
+                                              int16_t* x1, int16_t* y1);
+
+/*
+ * IntraDir grid layout (same grid as PB, log2UnitSize = Log2MinPUSize).
+ */
+LIBDE265_API void de265_internals_get_IntraDir_Info_layout(const struct de265_image* img,
+                                                           int* widthInUnits,
+                                                           int* heightInUnits,
+                                                           int* log2UnitSize);
+
+/*
+ * Per min-PU intra prediction direction.
+ * intraDir: luma direction [0,34].
+ * intraDirChroma: chroma direction (lower 6 bits) + mode4 flag (bit 7).
+ * Both arrays: widthInUnits * heightInUnits elements.
+ */
+LIBDE265_API void de265_internals_get_intraDir_info(const struct de265_image* img,
+                                                    uint8_t* intraDir,
+                                                    uint8_t* intraDirChroma);
+
+/*
+ * TU grid layout (log2UnitSize = Log2MinTrafoSize).
+ */
+LIBDE265_API void de265_internals_get_TUInfo_Info_layout(const struct de265_image* img,
+                                                         int* widthInUnits,
+                                                         int* heightInUnits,
+                                                         int* log2UnitSize);
+
+/*
+ * Per min-TU info byte:
+ *   bits 0:4  split_transform_flag depth mask (bit k = split at depth k)
+ *   bit  7    TU_FLAG_NONZERO_COEFF
+ * tuInfo: widthInUnits * heightInUnits elements.
+ */
+LIBDE265_API void de265_internals_get_TUInfo_info(const struct de265_image* img,
+                                                  uint8_t* tuInfo);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DE265_INTERNALS_H */
