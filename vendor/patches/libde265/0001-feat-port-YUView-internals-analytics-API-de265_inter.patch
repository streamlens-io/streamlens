+  {
+    for (int i = 0; i < pb_info.size(); i++) {
+      const PBMotion& mv = pb_info[i];
+      int pbSizePix = (1 << pb_info.log2unitSize);
+      int iXPix = (i % pb_info.width_in_units) * pbSizePix;
+      int iYPix = (i / pb_info.width_in_units) * pbSizePix;
+
+      int shdr_idx = get_SliceHeaderIndex(iXPix, iYPix);
+      int rPOC[2] = {0, 0};
+      if (shdr_idx < (int)slices.size()) {
+        const slice_segment_header* shdr = slices[shdr_idx];
+        if (mv.refIdx[0] < 16) rPOC[0] = shdr->RefPicList_POC[0][mv.refIdx[0]];
+        if (mv.refIdx[1] < 16) rPOC[1] = shdr->RefPicList_POC[1][mv.refIdx[1]];
+      }
+
+      if (mv.predFlag[0] != 1) {
+        refPOC0[i] = -1; x0[i] = 0; y0[i] = 0;
+      } else {
+        refPOC0[i] = static_cast<int16_t>(rPOC[0]);
+        x0[i] = mv.mv[0].x;
